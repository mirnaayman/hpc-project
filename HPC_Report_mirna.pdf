/E (mean_d = diseased[gene].mean\(\)  mean_h = healthy[gene].mean\(\)  diff = mean_d - mean_h  status = 'Upregulated' if diff > 1 else \('Downregulated' if diff < -1 else 'Not significant'\) comparison_results.append\(\(gene, mean_d, mean_h, diff, status\)\) )
/Pg 19 0 R
/K [1]
>>
